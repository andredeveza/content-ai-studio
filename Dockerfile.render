# Serviço de render (bloco 5) — processo separado no Render.com, porque
# a Vercel não sustenta Chromium (README, "Renderização"). Não é o
# Dockerfile do app Next.js principal (esse continua na Vercel).
FROM node:22-slim

# Libs de sistema exigidas pelo Chromium do @sparticuz/chromium fora de
# um runtime Lambda (ambiente Docker "normal" ainda precisa delas).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
EXPOSE 8080

# --conditions=react-server: os módulos de infra compartilhados com o
# app Next.js importam "server-only" (guarda contra vazar código de
# servidor pro bundle do cliente); fora do bundler do Next, isso só
# resolve sem lançar erro com essa condition (é o que o webpack do Next
# passa por baixo dos panos).
CMD ["npx", "tsx", "--conditions=react-server", "src/infra/render/server.ts"]
